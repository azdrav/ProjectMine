; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ProjectMine"
config/version="1.3"
run/main_scene="res://scenes/flow/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

FeedbackSettings="*res://scripts/systems/feedback_settings.gd"
GameFlow="*res://scripts/flow/game_flow.gd"
WebTrial="*res://scripts/systems/web_trial.gd"

[audio]

general/default_playback_type.web=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="GodotPhysics3D"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[layer_names]

3d_physics/layer_1="Level geometry"
3d_physics/layer_2="Player ship"
3d_physics/layer_3="Enemy drones"
